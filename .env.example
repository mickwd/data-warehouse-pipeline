# Copiar a .env y ajustar. docker-compose lee este archivo.
APP_ENV=docker
LOG_LEVEL=INFO

# --- SQL Server (Data Warehouse) ---
MSSQL_HOST=sqlserver
MSSQL_PORT=1433
MSSQL_DATABASE=dwh
MSSQL_USER=sa
MSSQL_PASSWORD=ChangeMe_123!

# --- Origenes batch ---
SOURCE_DB_URL=postgresql+psycopg://shop:shop@postgres:5432/shop
SOURCE_API_BASE_URL=http://products-api:8001
SOURCE_API_PAGE_SIZE=200

# --- Carga incremental ---
BATCH_LOOKBACK_MINUTES=10
BATCH_SAFETY_LAG_SECONDS=30

# --- Streaming ---
STREAM_BROKER=kafka
STREAM_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
STREAM_KAFKA_TOPIC=sales.events
STREAM_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
STREAM_TUMBLING_WINDOW_SECONDS=10
STREAM_SLIDING_WINDOW_SECONDS=60
STREAM_SLIDING_STEP_SECONDS=10
STREAM_ALLOWED_LATENESS_SECONDS=5
STREAM_PRODUCER_EVENTS_PER_SECOND=25

# --- Redis y PostgreSQL de métricas ---
REDIS_URL=redis://redis:6379/0
METRICS_DB_URL=postgresql+asyncpg://metrics:metrics@postgres:5432/metrics

# --- Postgres (superusuario del contenedor) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Airflow ---
AIRFLOW_ADMIN_PASSWORD=admin
